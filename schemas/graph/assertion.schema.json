{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mixu.app/graph/v1/assertion.schema.json",
  "title": "Assertion",
  "description": "A typed proposition attributed to a source. Testimony is not truth: the attribution class and epistemic status stay explicit, and later evidence appends transitions instead of rewriting history.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assertion_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "description": "Either an entity reference or a literal value; exactly one is present.",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "literal": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "qualifier": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-form and schema-validated qualifiers for story_time, diegetic_layer, hypothesis_frame, loop_epoch, episode_id, generation_era, and pov_entity_id.",
      "properties": {
        "story_time": {
          "type": "string",
          "minLength": 1
        },
        "diegetic_layer": {
          "type": "string",
          "enum": [
            "OUTER_REALITY",
            "INNER_WORK",
            "META_FRAME",
            "FOLKLORE_REFERENCE"
          ]
        },
        "hypothesis_frame": {
          "type": "string",
          "minLength": 1
        },
        "loop_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "generation_era": {
          "type": "string",
          "minLength": 1
        },
        "pov_entity_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "OBSERVATION",
            "NARRATOR",
            "WITNESS_CLAIM",
            "READER_INFERENCE",
            "LATER_CONFIRMATION"
          ]
        },
        "speaker_id": {
          "type": "string"
        },
        "context_anchor_id": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "first_reveal": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_anchor_id": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_status": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "CLAIMED",
        "INFERRED",
        "CORROBORATED",
        "CONTRADICTED",
        "RETRACTED",
        "UNRESOLVED"
      ]
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Uncalibrated extraction quality signal, NOT the probability that the proposition is true in the story."
    }
  },
  "required": [
    "assertion_id",
    "subject_id",
    "predicate",
    "object_ref",
    "attribution",
    "first_reveal",
    "evidence_anchor_id",
    "epistemic_status"
  ]
}
