{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mixu.app/api/v1/error.schema.json",
  "title": "ErrorEnvelope",
  "description": "Machine-readable error body. Clients branch on 'code', never on 'message'. Details must never carry credentials, book text, private notes or presigned URLs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "AUTH_REQUIRED",
        "INVALID_TOKEN",
        "FORBIDDEN",
        "NOT_FOUND",
        "INVALID_EDITION",
        "GRAPH_VERSION_UNSUPPORTED",
        "REVEAL_BOUNDARY_EXCEEDED",
        "INSUFFICIENT_CREDITS",
        "QUOTE_EXPIRED",
        "SPEND_CAP_EXCEEDED",
        "UPLOAD_NOT_VERIFIED",
        "STORAGE_QUOTA_EXCEEDED",
        "RIGHTS_REVIEW_REQUIRED",
        "SYNC_CONFLICT",
        "BUILD_CANCELLED",
        "PROVIDER_UNAVAILABLE",
        "RATE_LIMITED",
        "INVALID_REQUEST",
        "INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "description": "Safe, human-readable, no secrets."
    },
    "request_id": {
      "type": "string",
      "description": "Correlation id for support and log lookup."
    },
    "details": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional structured context; must stay free of user content."
    }
  },
  "required": [
    "code",
    "message",
    "request_id"
  ]
}
